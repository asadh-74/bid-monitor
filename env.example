# Required (same Google Sheet and service account currently used on Render)
GOOGLE_SHEETS_ID=your_sheet_id
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
ADMIN_TOKEN=replace-with-a-long-random-secret

# Optional
SCRAPE_INTERVAL_HOURS=12
RENDERER=playwright
NYSCR_AGENCY_FILTER=
NYSCR_MAX_PAGES=40

# Total Bid Data (set privately on Render; never commit actual credentials)
TOTALBIDDATA_USERNAME=
TOTALBIDDATA_PASSWORD=
TOTALBIDDATA_MAX_PAGES=1000
TOTALBIDDATA_DETAIL_LIMIT=100

# Configure privately on Render; never commit credentials.
MYVENDORLINK_EMAIL=
MYVENDORLINK_PASSWORD=
MYVENDORLINK_MAX_PAGES=100
MYVENDORLINK_DETAIL_LIMIT=100
