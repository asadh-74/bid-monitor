# Required: use Render Postgres, not ephemeral SQLite on Render
DATABASE_URL=postgresql://user:password@localhost:5432/bid_monitor
ADMIN_TOKEN=replace-with-a-long-random-secret

# Optional
SCRAPE_INTERVAL_HOURS=12
RENDERER=playwright
NYSCR_AGENCY_FILTER=
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Only needed if RENDERER=firecrawl
FIRECRAWL_API_KEY=
